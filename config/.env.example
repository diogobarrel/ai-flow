# ──────────────────────────────────────────────────────────────────
# ai-dev-flow — Variáveis de Ambiente
# Copie para .env e preencha com seus valores reais
# NUNCA commite o .env no git
# ──────────────────────────────────────────────────────────────────

# ── Autenticação das CLIs ──────────────────────────────────────────
# Claude Code e Gemini CLI se autenticam por conta (OAuth) — sem API key necessária.
#
# Claude Code: execute `claude` pela primeira vez e siga o login
# Gemini CLI:  execute `gemini auth login` para autenticar com sua conta Google
#
# As keys abaixo são OPCIONAIS — só necessárias se você for usar
# as APIs diretamente (via SDK, curl, scripts Python, etc.)

# Anthropic API (opcional — só para uso direto da API)
# Obtenha em: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Google AI / Gemini API (opcional — só para uso direto da API)
# Obtenha em: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIzaSy...

# ── Projeto (preencha por projeto) ────────────────────────────────
PROJECT_NAME=meu-projeto
PROJECT_VERSION=v1.0.0
IMPLEMENTATION_BRANCH=v1-implementation

# ── Banco de dados (se aplicável) ─────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/dbname
# REDIS_URL=redis://localhost:6379

# ── Servidor (se aplicável) ───────────────────────────────────────
# API_PORT=8000
# LOG_LEVEL=info
# ENVIRONMENT=development

# ── CI/CD (se aplicável) ──────────────────────────────────────────
# GITHUB_TOKEN=ghp_...
# DOCKER_REGISTRY=ghcr.io/seu-usuario
